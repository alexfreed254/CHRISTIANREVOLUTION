# Optional payment gateway env vars (also configurable via Superadmin → Payment Setup)

# PayPal
# PAYPAL_EMAIL=church@example.com
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# PAYPAL_PLAN_ID=   # optional monthly subscription plan

# Stripe (cards · Apple Pay · Google Pay)
# STRIPE_SECRET_KEY=sk_live_...        # server only — set on Render
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_ACCOUNT_ID=acct_...             # where funds go — also in superadmin Payment Setup
# STRIPE_DISPLAY_NAME=Christ Revolution Movement
# STRIPE_ENABLED=true

# M-Pesa Daraja
# MPESA_TILL_NUMBER=
# MPESA_SHORTCODE=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_ENV=sandbox
# MPESA_CALLBACK_URL=https://your-app.onrender.com/api/payments/mpesa/callback
