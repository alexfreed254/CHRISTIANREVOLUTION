# Supabase Configuration
# Project URL from Supabase → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# IMPORTANT: use the service_role key (secret), NOT the anon/public key.
# Supabase → Settings → API → service_role
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Supabase anon/public key — required for super admin login via Supabase Authentication
# Supabase → Settings → API → anon public
SUPABASE_ANON_KEY=your-anon-public-key-here

# Session / JWT secrets (long random strings)
SESSION_SECRET=your-random-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Super admin: create in Supabase Dashboard → Authentication → Users → Add user
# See SUPERADMIN_SETUP.md (set User Metadata role to super_admin)

# Application Settings
ENVIRONMENT=production
PORT=8000
ALLOWED_ORIGINS=*

# ── Optional: AI translation (OpenAI) ──
# Required for automatic translation to Kenya's languages (Kiswahili, Kikuyu, Luo, etc.)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# TRANSLATION_ENABLED=true

# PAYPAL_EMAIL=church@paypal.com
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# PAYPAL_PLAN_ID=

# ── Optional: M-Pesa Daraja STK Push ──
# MPESA_TILL_NUMBER=
# MPESA_SHORTCODE=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_ENV=sandbox
# MPESA_CALLBACK_URL=https://your-app.onrender.com/api/payments/mpesa/callback
