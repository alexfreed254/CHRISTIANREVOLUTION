# Supabase Configuration
# Project URL from Supabase → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# IMPORTANT: use the service_role key (secret), NOT the anon/public key.
# Supabase → Settings → API → service_role
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Session / JWT secrets (long random strings)
SESSION_SECRET=your-random-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Promote this email to super_admin automatically on login
SUPERADMIN_EMAIL=you@example.com

# Application Settings
ENVIRONMENT=production
PORT=8000
ALLOWED_ORIGINS=*
